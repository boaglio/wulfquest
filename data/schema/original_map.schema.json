{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wulfquest.invalid/schema/original_map.schema.json",
  "title": "original_map.json — AGENTS.md §8 (extracted canon; no schemaVersion by design)",
  "type": "object",
  "additionalProperties": false,
  "required": ["gridW", "gridH", "startCol", "startRow", "roomTypeGrid", "numTemplates", "templates"],
  "properties": {
    "gridW": { "type": "integer", "const": 16 },
    "gridH": { "type": "integer", "const": 16 },
    "startCol": { "type": "integer", "minimum": 0, "maximum": 15 },
    "startRow": { "type": "integer", "minimum": 0, "maximum": 15 },
    "numTemplates": { "type": "integer", "minimum": 1 },
    "roomTypeGrid": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "array",
        "minItems": 16,
        "maxItems": 16,
        "items": { "type": "integer", "minimum": 0 }
      }
    },
    "templates": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[0-9]+$" },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["graphic", "x", "y"],
          "properties": {
            "graphic": { "type": "string", "pattern": "^[0-9A-F]{4}$" },
            "x": { "type": "integer", "minimum": 0, "maximum": 31 },
            "y": { "type": "integer", "minimum": 0, "maximum": 23 }
          }
        }
      }
    }
  }
}
