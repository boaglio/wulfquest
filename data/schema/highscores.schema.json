{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wulfquest.invalid/schema/highscores.schema.json",
  "title": "highscores.json — AGENTS.md §21.2 (the player DB table and the shipped defaults)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "entries": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "score", "pieces", "ticks", "date"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z ]{1,8}$" },
          "score": { "type": "integer", "minimum": 0 },
          "pieces": { "type": "integer", "minimum": 0, "maximum": 4 },
          "ticks": { "type": "integer", "minimum": 0 },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    }
  }
}
