{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wulfquest.invalid/schema/music.schema.json",
  "title": "music.json — AGENTS.md §18.3 (original compositions only, monophonic square wave)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tunes"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "tunes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bpm", "loop", "notes"],
        "properties": {
          "bpm": { "type": "integer", "minimum": 30, "maximum": 300 },
          "loop": { "type": "boolean" },
          "notes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2048,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["note", "octave", "ms"],
              "properties": {
                "note": { "enum": ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B", "R"] },
                "octave": { "type": "integer", "minimum": 0, "maximum": 8 },
                "ms": { "type": "integer", "minimum": 1, "maximum": 5000 }
              }
            }
          }
        }
      }
    }
  }
}
