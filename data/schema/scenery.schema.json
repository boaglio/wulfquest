{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wulfquest.invalid/schema/scenery.schema.json",
  "title": "world/scenery.json — AGENTS.md §9, §7.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "solidCoveragePercent", "objects"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "solidCoveragePercent": { "type": "integer", "minimum": 1, "maximum": 100 },
    "objects": {
      "type": "object",
      "propertyNames": { "pattern": "^[0-9A-F]{4}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cells", "sprite", "subject", "biomeHint", "fidelity"],
        "properties": {
          "cells": {
            "type": "object", "additionalProperties": false, "required": ["w", "h"],
            "properties": {
              "w": { "type": "integer", "minimum": 1, "maximum": 32 },
              "h": { "type": "integer", "minimum": 1, "maximum": 24 }
            }
          },
          "sprite": { "type": "string", "pattern": "^scenery_[0-9a-f]{4}$" },
          "subject": { "type": "string", "minLength": 1 },
          "biomeHint": { "enum": ["jungle", "swamp", "mountain", "bonefields", "hut", "water", "arch"] },
          "collisionCells": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "pattern": "^[#.]+$" }
          },
          "fidelity": { "const": "recon-art-canon-footprint" }
        }
      }
    }
  }
}
