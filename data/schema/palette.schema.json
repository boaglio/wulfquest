{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wulfquest.invalid/schema/palette.schema.json",
  "title": "palette.json — AGENTS.md §5.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "transparent", "entries"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "transparent": { "type": "integer", "const": -1 },
    "entries": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["i", "name", "rgb"],
        "properties": {
          "i": { "type": "integer", "minimum": 0, "maximum": 15 },
          "name": { "type": "string", "pattern": "^[a-zA-Z]+$" },
          "rgb": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        }
      }
    }
  }
}
