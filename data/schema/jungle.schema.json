{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wulfquest.invalid/schema/jungle.schema.json",
  "title": "entities/jungle.json — AGENTS.md §12.8 [CANON]: the original's creatures",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fidelity",
    "swarm",
    "creatures"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "fidelity": {
      "enum": [
        "canon",
        "recon"
      ]
    },
    "swarm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roomMax",
        "slots",
        "everyTicks",
        "appearTicks",
        "lingerTicks",
        "quietAfterGettingUpTicks",
        "area",
        "playerClearancePx",
        "pick",
        "tints",
        "appearScores",
        "facingRightBonus"
      ],
      "properties": {
        "roomMax": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "slots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "everyTicks": {
          "type": "integer",
          "minimum": 1
        },
        "appearTicks": {
          "type": "integer",
          "minimum": 1
        },
        "lingerTicks": {
          "type": "integer",
          "minimum": 0
        },
        "quietAfterGettingUpTicks": {
          "type": "integer",
          "minimum": 0
        },
        "area": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 175
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 176
            }
          }
        },
        "playerClearancePx": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "pick": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "table",
            "open",
            "openPerQuarter",
            "fold"
          ],
          "properties": {
            "table": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "open": {
              "type": "integer",
              "minimum": 1
            },
            "openPerQuarter": {
              "type": "integer",
              "minimum": 0
            },
            "fold": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "tints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "appearScores": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "facingRightBonus": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "creatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/species"
      }
    }
  },
  "$defs": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "h": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "species": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "sprite",
        "size",
        "collisionBox",
        "speed",
        "hp",
        "score",
        "ignoresScenery",
        "behaviour"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "sprite": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "size": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "w",
            "h"
          ],
          "properties": {
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          }
        },
        "collisionBox": {
          "$ref": "#/$defs/box"
        },
        "speed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "xFp",
            "yFp"
          ],
          "properties": {
            "xFp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "yFp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            }
          }
        },
        "hp": {
          "type": "integer",
          "minimum": 1
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "ignoresScenery": {
          "type": "boolean"
        },
        "behaviour": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "params"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "pattern": "^[A-Z][A-Z_]*$"
            },
            "params": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
