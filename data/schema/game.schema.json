{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wulfquest.invalid/schema/game.schema.json",
  "title": "game.json — AGENTS.md §6.1, §7.5, §12.6, §14.4, §16.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tickHz", "maxCatchupTicks", "transition", "difficulty", "exit", "newGamePlus", "easy", "continues", "features"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "tickHz": { "type": "integer", "minimum": 1, "maximum": 240 },
    "maxCatchupTicks": { "type": "integer", "minimum": 1, "maximum": 60 },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freezeTicks", "wulfArrivalDelayTicks"],
      "properties": {
        "freezeTicks": { "type": "integer", "minimum": 0 },
        "wulfArrivalDelayTicks": { "type": "integer", "minimum": 0 }
      }
    },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budgetBonusByPieces", "maxRoomBudget"],
      "properties": {
        "budgetBonusByPieces": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "type": "integer", "minimum": 0 }
        },
        "maxRoomBudget": { "type": "integer", "minimum": 1 }
      }
    },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keeperNudgeZonePx", "keeperNudgePx"],
      "properties": {
        "keeperNudgeZonePx": { "type": "integer", "minimum": 0 },
        "keeperNudgePx": { "type": "integer", "minimum": 0, "maximum": 64 }
      }
    },
    "continues": {
      "description": "§17.5 [NEW]: how many times a game may go on after game over, in either mode",
      "type": "integer", "minimum": 0, "maximum": 9
    },
    "easy": {
      "description": "§17.8 [NEW]: Easy mode, chosen on the title; the game as it is otherwise is Hard",
      "type": "object",
      "additionalProperties": false,
      "required": ["livesStart", "swarmRoomMax", "swarmOpenPerQuarter", "wulfSpeedPercent", "beastSpeedPercent", "flame", "showWayTicks", "hintsOncePerLife"],
      "properties": {
        "livesStart": { "type": "integer", "minimum": 0, "maximum": 9 },
        "swarmRoomMax": { "type": "integer", "minimum": 0, "maximum": 6 },
        "swarmOpenPerQuarter": { "type": "integer", "minimum": 0, "maximum": 2 },
        "wulfSpeedPercent": { "type": "integer", "minimum": 25, "maximum": 200 },
        "beastSpeedPercent": { "type": "integer", "minimum": 25, "maximum": 100 },
        "flame": { "type": "boolean" },
        "showWayTicks": { "type": "integer", "minimum": 1 },
        "hintsOncePerLife": { "type": "boolean" }
      }
    },
    "newGamePlus": {
      "description": "§14.9 [NEW]: the jobs after the first. Level 0 is the game itself; each level after it is unlocked by winning the one before",
      "type": "object",
      "additionalProperties": false,
      "required": ["levels"],
      "properties": {
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pieces", "rampHeadStart", "wulfSpeedPercent"],
            "properties": {
              "pieces": {
                "description": "one entry per piece hidden: the panel slots (0..3) it fills. Together they fill all four",
                "type": "array",
                "minItems": 1,
                "items": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 3 } }
              },
              "rampHeadStart": { "description": "quarters added to those held when the jungle decides how hard to be", "type": "integer", "minimum": 0, "maximum": 4 },
              "wulfSpeedPercent": { "type": "integer", "minimum": 50, "maximum": 200 }
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caveHints", "animatedWater", "distanceDrivenGait", "roamingWulf", "inventedOrchids", "inventedCreatures", "inkedCreatures",
                   "bonusRooms", "pauseMap", "stats"],
      "patternProperties": { "^[a-zA-Z]+$": { "type": "boolean" } }
    }
  }
}
