{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wulfquest.invalid/schema/shell.schema.json",
  "title": "shell.json — AGENTS.md §17.1, §17.2, §17.5",
  "type": "object",
  "$defs": {
    "entry": {
      "type": "object", "additionalProperties": false, "required": ["id", "label"],
      "properties": { "id": { "type": "string", "pattern": "^[a-zA-Z]+$" }, "label": { "type": "string", "minLength": 1, "maxLength": 32 } }
    },
    "offset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dx", "dy"],
      "properties": { "dx": { "type": "integer" }, "dy": { "type": "integer" } }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker", "at", "y", "colour", "text"],
      "properties": {
        "speaker": { "enum": ["vale", "jones"] },
        "at": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "colour": { "type": "string", "minLength": 1 },
        "text": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "verses": {
      "type": "array",
      "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
    }
  },
  "additionalProperties": false,
  "required": ["schemaVersion", "screenHoldTicks", "title", "attract", "gameOver", "ending", "tally", "hiScores",
               "keyConfig", "sound", "stats", "amuletReveal", "map", "saves", "credits", "newGamePlus",
               "difficulty", "pause", "options"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "screenHoldTicks": { "type": "integer", "minimum": 0, "maximum": 600 },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wordmark", "tagline", "items", "marker", "newGameKey", "newGameLabel", "continueDetail", "cycle", "menu", "footer"],
      "properties": {
        "wordmark": { "type": "string", "minLength": 1, "maxLength": 20 },
        "tagline": { "type": "string", "maxLength": 48 },
        "items": {
          "description": "AGENTS.md §17.2: the title's menu, up and down to choose and fire to pick; 'continue' shows only while a game is saved",
          "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" }
        },
        "newGameKey": { "description": "AGENTS.md §17.2: a letter that starts a new game, not listed on the title", "type": "string", "pattern": "^[A-Z0-9]$" },
        "newGameLabel": { "description": "AGENTS.md §17.2: what 'start' reads while 'continue' is offered", "type": "string", "minLength": 1, "maxLength": 32 },
        "continueDetail": { "description": "AGENTS.md §17.2: under 'continue', the saved game: {line} is its line on the load page", "type": "string", "minLength": 1, "maxLength": 20 },
        "cycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["colours", "ticksPerStep"],
          "properties": {
            "colours": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "type": "string" } },
            "ticksPerStep": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "menu": {
          "description": "AGENTS.md §17.2: letters that open a page from the title, not listed on it: the options page lists them",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "screen", "label"],
            "properties": {
              "key": { "type": "string", "pattern": "^[A-Z0-9]$" },
              "screen": { "enum": ["HISCORES", "STATS", "KEY_CONFIG", "SOUND", "LOAD_GAME", "OPTIONS"] },
              "label": { "type": "string", "minLength": 1, "maxLength": 32 }
            }
          }
        },
        "footer": { "type": "string", "maxLength": 78 },
        "marker": {
          "description": "AGENTS.md §17.2: the sprite before the line chosen, on the title and every menu",
          "type": "object",
          "additionalProperties": false,
          "required": ["sprite", "frame"],
          "properties": {
            "sprite": { "type": "string", "minLength": 1 },
            "frame": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "attract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idleTicks", "replay", "banner", "dimEveryOtherRow"],
      "properties": {
        "idleTicks": { "type": "integer", "minimum": 50, "maximum": 20000 },
        "replay": { "type": "string", "minLength": 1 },
        "banner": { "type": "string", "maxLength": 48 },
        "dimEveryOtherRow": { "type": "boolean" },
        "intro": {
          "description": "AGENTS.md §17.2: the scene the idle title shows before the demo, a plane landing in the forest",
          "type": "object",
          "additionalProperties": false,
          "required": ["backdrop", "plane", "text", "textAt", "textY", "textColour", "ticksPerChar", "ticks"],
          "properties": {
            "backdrop": {
              "type": "array", "maxItems": 40,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["sprite", "frame", "x", "y"],
                "properties": {
                  "sprite": { "type": "string", "minLength": 1 }, "frame": { "type": "string", "minLength": 1 },
                  "x": { "type": "integer", "minimum": -320, "maximum": 640 }, "y": { "type": "integer", "minimum": -256, "maximum": 512 }
                }
              }
            },
            "plane": {
              "type": "object", "additionalProperties": false,
              "required": ["sprite", "frames", "ticksPerFrame", "parked", "path"],
              "properties": {
                "sprite": { "type": "string", "minLength": 1 },
                "frames": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "ticksPerFrame": { "type": "integer", "minimum": 1, "maximum": 100 },
                "parked": { "type": "string", "minLength": 1 },
                "path": {
                  "description": "where the plane's wheels are, tick by tick; straight lines between, at strictly rising ticks",
                  "type": "array", "minItems": 2, "maxItems": 20,
                  "items": {
                    "type": "object", "additionalProperties": false, "required": ["at", "x", "y"],
                    "properties": {
                      "at": { "type": "integer", "minimum": 0, "maximum": 20000 },
                      "x": { "type": "integer", "minimum": -320, "maximum": 640 },
                      "y": { "type": "integer", "minimum": -256, "maximum": 512 }
                    }
                  }
                }
              }
            },
            "text": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
            "textAt": { "type": "integer", "minimum": 0, "maximum": 20000 },
            "textY": { "type": "integer", "minimum": 0, "maximum": 256 },
            "textColour": { "type": "string", "minLength": 1 },
            "ticksPerChar": { "type": "integer", "minimum": 1, "maximum": 50 },
            "ticks": { "type": "integer", "minimum": 1, "maximum": 20000 }
          }
        }
      }
    },
    "gameOver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "progress", "holdTicks", "continuePrompt", "continuesLeft", "continueTicks",
                   "countdownScale"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 20 },
        "progress": { "type": "string", "pattern": "\\{percent\\}", "maxLength": 32 },
        "holdTicks": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "continuePrompt": { "description": "§17.5 [NEW]", "type": "string", "minLength": 1, "maxLength": 32 },
        "continuesLeft": { "type": "string", "pattern": "\\{n\\}", "maxLength": 32 },
        "continueTicks": { "type": "integer", "minimum": 50, "maximum": 3000 },
        "countdownScale": { "description": "the seconds left, under the offer, this many times the big font", "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "ending": {
      "description": "AGENTS.md §14.7 [NEW]: the closing scene, Vale bringing the amulet to Mr Jones",
      "type": "object",
      "additionalProperties": false,
      "required": ["backdrop", "groundY", "vale", "jones", "amulet", "lines", "ticksPerChar", "tune", "tuneAt",
                   "prompt", "promptAt", "promptColour"],
      "properties": {
        "backdrop": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sprite", "frame", "x", "y"],
            "properties": {
              "sprite": { "type": "string", "minLength": 1 },
              "frame": { "type": "string", "minLength": 1 },
              "x": { "type": "integer" },
              "y": { "type": "integer" }
            }
          }
        },
        "groundY": { "type": "integer", "minimum": 0 },
        "vale": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sprite", "walk", "ticksPerFrame", "stand", "fromX", "toX", "walkTicks"],
          "properties": {
            "sprite": { "type": "string", "minLength": 1 },
            "walk": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "ticksPerFrame": { "type": "integer", "minimum": 1 },
            "stand": { "type": "string", "minLength": 1 },
            "fromX": { "type": "integer" },
            "toX": { "type": "integer" },
            "walkTicks": { "type": "integer", "minimum": 1 }
          }
        },
        "jones": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sprite", "x", "stand", "talk", "hold", "holdTalk", "talkTicksPerFrame"],
          "properties": {
            "sprite": { "type": "string", "minLength": 1 },
            "x": { "type": "integer" },
            "stand": { "type": "string", "minLength": 1 },
            "talk": { "type": "string", "minLength": 1 },
            "hold": { "type": "string", "minLength": 1 },
            "holdTalk": { "type": "string", "minLength": 1 },
            "talkTicksPerFrame": { "type": "integer", "minimum": 1 }
          }
        },
        "amulet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["carry", "hold", "handOverAt", "handOverTicks"],
          "properties": {
            "carry": { "$ref": "#/$defs/offset" },
            "hold": { "$ref": "#/$defs/offset" },
            "handOverAt": { "type": "integer", "minimum": 0 },
            "handOverTicks": { "type": "integer", "minimum": 1 }
          }
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/line" }
        },
        "ticksPerChar": { "type": "integer", "minimum": 1 },
        "tune": { "type": "string", "minLength": 1 },
        "tuneAt": { "type": "integer", "minimum": 0 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 40 },
        "promptAt": { "type": "integer", "minimum": 0 },
        "promptColour": { "type": "string", "minLength": 1 }
      }
    },
    "tally": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holdTicks", "heading", "labels", "total", "newBest", "prompt", "lineEveryTicks",
                   "headingColour", "labelColour", "figureColour"],
      "properties": {
        "holdTicks": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "heading": { "type": "string", "minLength": 1, "maxLength": 40 },
        "labels": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 20 } },
        "total": { "type": "string", "minLength": 1, "maxLength": 20 },
        "newBest": { "type": "string", "minLength": 1, "maxLength": 40 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 40 },
        "lineEveryTicks": { "type": "integer", "minimum": 1 },
        "headingColour": { "type": "string", "minLength": 1 },
        "labelColour": { "type": "string", "minLength": 1 },
        "figureColour": { "type": "string", "minLength": 1 }
      }
    },
    "hiScores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "entryHeading", "entryPrompt", "size", "nameLength", "alphabet",
                   "cursorBlinkTicks", "repeatDelayTicks", "repeatEveryTicks"],
      "properties": {
        "heading": { "type": "string", "minLength": 1, "maxLength": 32 },
        "entryHeading": { "type": "string", "minLength": 1, "maxLength": 32 },
        "entryPrompt": { "type": "string", "maxLength": 48 },
        "size": { "type": "integer", "minimum": 1, "maximum": 20 },
        "nameLength": { "type": "integer", "minimum": 1, "maximum": 8 },
        "alphabet": { "type": "string", "minLength": 2 },
        "cursorBlinkTicks": { "type": "integer", "minimum": 1, "maximum": 100 },
        "repeatDelayTicks": { "type": "integer", "minimum": 1, "maximum": 100 },
        "repeatEveryTicks": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "keyConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "prompt", "actionOrder"],
      "properties": {
        "heading": { "type": "string", "minLength": 1, "maxLength": 32 },
        "prompt": { "type": "string", "maxLength": 56 },
        "actionOrder": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "enum": ["UP", "DOWN", "LEFT", "RIGHT", "FIRE", "PAUSE", "QUIT", "MAP"] }
        }
      }
    },
    "sound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "prompt", "onLabel", "offLabel", "volumeLabel", "volumeStepPercent"],
      "properties": {
        "heading": { "type": "string", "minLength": 1, "maxLength": 32 },
        "prompt": { "type": "string", "maxLength": 56 },
        "onLabel": { "type": "string", "minLength": 1, "maxLength": 32 },
        "offLabel": { "type": "string", "minLength": 1, "maxLength": 32 },
        "volumeLabel": { "type": "string", "minLength": 1, "maxLength": 32 },
        "volumeStepPercent": { "type": "integer", "minimum": 1, "maximum": 50 }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "emptyLine"],
      "properties": {
        "heading": { "type": "string", "minLength": 1, "maxLength": 32 },
        "emptyLine": { "type": "string", "maxLength": 48 }
      }
    },
    "amuletReveal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skipAfterTicks", "scale", "prompt", "verses"],
      "properties": {
        "skipAfterTicks": { "type": "integer", "minimum": 0 },
        "scale": { "type": "integer", "minimum": 1, "maximum": 8 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 32 },
        "verses": { "$ref": "#/$defs/verses" }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "message", "visited", "revealed", "here", "blinkTicks", "quarterIcon", "exitIcon", "trail"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Z0-9]$" },
        "profileKeys": {
          "description": "AGENTS.md §17.7: the map's key in an input profile that plays with the usual one",
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[A-Z0-9]$" }
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 48 },
        "visited": { "type": "string", "minLength": 1 },
        "revealed": { "type": "string", "minLength": 1 },
        "here": { "type": "string", "minLength": 1 },
        "blinkTicks": { "type": "integer", "minimum": 1 },
        "quarterIcon": {
          "description": "AGENTS.md §17.7 [NEW]: the mark on a quarter's room — shiny frames in turn while it waits, one dull frame once taken",
          "type": "object",
          "additionalProperties": false,
          "required": ["sprite", "shiny", "frameTicks", "taken"],
          "properties": {
            "sprite": { "type": "string", "minLength": 1 },
            "shiny": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "frameTicks": { "type": "integer", "minimum": 1 },
            "taken": { "type": "string", "minLength": 1 }
          }
        },
        "exitIcon": {
          "description": "AGENTS.md §17.7 [NEW]: the mark on the arch's room, the way out — always shown; its open frames in turn once the amulet is whole",
          "type": "object",
          "additionalProperties": false,
          "required": ["sprite", "frame", "open", "frameTicks"],
          "properties": {
            "sprite": { "type": "string", "minLength": 1 },
            "frame": { "type": "string", "minLength": 1 },
            "open": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "frameTicks": { "type": "integer", "minimum": 1 }
          }
        },
        "trail": {
          "description": "AGENTS.md §14.10 [NEW]: the way a looking glass shows, marching dots from Vale's room to the next quarter",
          "type": "object",
          "additionalProperties": false,
          "required": ["colour", "dotEveryPx", "marchTicks"],
          "properties": {
            "colour": { "type": "string", "minLength": 1 },
            "dotEveryPx": { "type": "integer", "minimum": 1, "maximum": 16 },
            "marchTicks": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "saves": {
      "description": "AGENTS.md §21.4 [NEW]: the save slots, offered from the pause menu and the title",
      "type": "object",
      "additionalProperties": false,
      "required": ["slots", "saveHeading", "loadHeading", "slot", "detail", "empty", "jobNames", "modeNames", "saved",
                   "loaded", "emptySlot", "refused", "noteTicks", "footer", "newGameHeading", "replace",
                   "autosaveEveryTicks", "autosaved"],
      "properties": {
        "slots": { "type": "integer", "minimum": 1, "maximum": 9 },
        "saveHeading": { "type": "string", "minLength": 1, "maxLength": 32 },
        "loadHeading": { "type": "string", "minLength": 1, "maxLength": 32 },
        "slot": { "type": "string", "pattern": "\\{n\\}", "maxLength": 60 },
        "detail": { "type": "string", "maxLength": 60 },
        "empty": { "type": "string", "pattern": "\\{n\\}", "maxLength": 40 },
        "jobNames": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 12 } },
        "modeNames": {
          "type": "object", "additionalProperties": false, "required": ["hard", "easy"],
          "properties": { "hard": { "type": "string", "maxLength": 8 }, "easy": { "type": "string", "maxLength": 8 } }
        },
        "saved": { "type": "string", "maxLength": 40 },
        "loaded": { "type": "string", "maxLength": 40 },
        "emptySlot": { "type": "string", "maxLength": 40 },
        "refused": { "description": "AGENTS.md §17.2: the title's word when the saved game fire would go on with will not load", "type": "string", "maxLength": 40 },
        "noteTicks": { "type": "integer", "minimum": 1 },
        "footer": { "type": "string", "maxLength": 60 },
        "newGameHeading": { "description": "AGENTS.md §21.4: the page a new game picks its slot on", "type": "string", "minLength": 1, "maxLength": 32 },
        "replace": { "description": "AGENTS.md §21.4: said when the slot picked for a new game holds one; a second fire replaces it", "type": "string", "pattern": "\\{n\\}", "maxLength": 40 },
        "autosaveEveryTicks": { "description": "AGENTS.md §21.4: a game saves itself to its slot this often, in ticks of play", "type": "integer", "minimum": 50 },
        "autosaved": { "description": "AGENTS.md §21.4: the panel's word when it has", "type": "string", "maxLength": 40 }
      }
    },
    "credits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "lines", "prompt", "roll"],
      "properties": {
        "heading": { "type": "string", "minLength": 1, "maxLength": 32 },
        "lines": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "string", "maxLength": 48 } },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 48 },
        "roll": {
          "description": "AGENTS.md §14.7 [NEW]: the credits rolled up the screen after a win",
          "type": "object",
          "additionalProperties": false,
          "required": ["theEnd", "before", "after", "fromY", "lineHeightPx", "ticksPerPx", "headingColour", "bodyColour", "hint", "paused"],
          "properties": {
            "theEnd": { "type": "string", "minLength": 1, "maxLength": 40 },
            "before": { "type": "array", "items": { "type": "string", "maxLength": 40 } },
            "after": { "type": "array", "items": { "type": "string", "maxLength": 40 } },
            "fromY": { "type": "integer", "minimum": 0 },
            "lineHeightPx": { "type": "integer", "minimum": 1 },
            "ticksPerPx": { "type": "integer", "minimum": 1 },
            "headingColour": { "type": "string", "minLength": 1 },
            "bodyColour": { "type": "string", "minLength": 1 },
            "hint": { "type": "string", "maxLength": 40 },
            "paused": { "type": "string", "minLength": 1, "maxLength": 40 }
          }
        }
      }
    },
    "pause": {
      "description": "§17.4 [NEW]: the pause menu over the frozen jungle",
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "items", "footer"],
      "properties": {
        "heading": { "type": "string", "minLength": 1, "maxLength": 32 },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } },
        "footer": { "type": "string", "maxLength": 60 }
      }
    },
    "options": {
      "description": "§17.9 [NEW]: the options page, from the title and the pause menu; the pause menu's leaves out difficulty, keys, load, hiScores and stats",
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "items", "on", "off", "footer", "volumeFooter", "eightBit", "scales", "scaleLabel", "scaleFooter"],
      "properties": {
        "heading": { "type": "string", "minLength": 1, "maxLength": 32 },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } },
        "on": { "type": "string", "minLength": 1, "maxLength": 8 },
        "off": { "type": "string", "minLength": 1, "maxLength": 8 },
        "footer": { "type": "string", "maxLength": 60 },
        "volumeFooter": { "type": "string", "maxLength": 60 },
        "scales": {
          "description": "AGENTS.md §17.9: the window's sizes the scale line steps through, each within display.json's scale",
          "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 12 }
        },
        "scaleLabel": { "type": "string", "pattern": "\\{n\\}", "maxLength": 8 },
        "scaleFooter": { "type": "string", "maxLength": 60 },
        "fullscreenKey": {
          "description": "AGENTS.md §17.9: the key that switches full screen on and off anywhere, so a screen that goes wrong can be left",
          "type": "string", "pattern": "^F([1-9]|1[0-2])$"
        },
        "eightBit": {
          "description": "AGENTS.md §17.9: the switches 8-BIT MODE turns on and off together, for the look of the original",
          "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "difficulty": {
      "description": "§17.8 [NEW]: Easy mode or Hard, switched on the title's options; hard and easy are the words for each",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "hard", "easy", "easyColour", "panelLabel", "hiScoreMark"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Z0-9]$" },
        "hard": { "type": "string", "minLength": 1, "maxLength": 60 },
        "easy": { "type": "string", "minLength": 1, "maxLength": 60 },
        "easyColour": { "type": "string", "minLength": 1 },
        "panelLabel": { "type": "string", "minLength": 1, "maxLength": 12 },
        "hiScoreMark": { "type": "string", "minLength": 1, "maxLength": 2 }
      }
    },
    "newGamePlus": {
      "description": "§14.9 [NEW]: the jobs after the first, one entry per level of game.json → newGamePlus",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "labelColour", "levels"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Z0-9]$" },
        "labelColour": { "type": "string", "minLength": 1 },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 60 },
              "tagline": { "description": "the title's tagline while this job is chosen; the game itself keeps title.tagline", "type": "string", "minLength": 1, "maxLength": 48 },
              "verses": { "$ref": "#/$defs/verses" },
              "amulet": {
                "description": "§14.9: this job's own amulet, a frame of the amulet sprite for each panel slot, 0..3 reading across",
                "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string", "minLength": 1 }
              },
              "theEnd": { "description": "§14.7: the credits roll's first row after winning this job", "type": "string", "minLength": 1, "maxLength": 40 },
              "ending": {
                "description": "§14.7: this job's own closing scene, laid over the game's ending",
                "type": "object",
                "additionalProperties": false,
                "required": ["lines", "tuneAt", "promptAt"],
                "properties": {
                  "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/line" } },
                  "tuneAt": { "type": "integer", "minimum": 0 },
                  "promptAt": { "type": "integer", "minimum": 0 },
                  "ride": {
                    "description": "the ride home: two horses trot in, Vale and Mr Jones mount, and they gallop off",
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["sprite", "ticksPerFrame", "comeAt", "comeTicks", "fromX", "valeHorse", "jonesHorse",
                                 "mountAt", "valeRiding", "jonesRiding", "rideAt", "rideTicks", "toX"],
                    "properties": {
                      "sprite": { "type": "string", "minLength": 1 },
                      "ticksPerFrame": { "type": "integer", "minimum": 1 },
                      "comeAt": { "type": "integer", "minimum": 0 },
                      "comeTicks": { "type": "integer", "minimum": 1 },
                      "fromX": { "type": "integer" },
                      "valeHorse": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                      "jonesHorse": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                      "mountAt": { "type": "integer", "minimum": 0 },
                      "valeRiding": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                      "jonesRiding": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                      "rideAt": { "type": "integer", "minimum": 0 },
                      "rideTicks": { "type": "integer", "minimum": 1 },
                      "toX": { "type": "integer" }
                    }
                  }
                }
              },
              "offer": {
                "description": "the scene after the credits of the win that unlocks this level",
                "type": "object",
                "additionalProperties": false,
                "required": ["lines", "promptAt"],
                "properties": {
                  "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/line" } },
                  "promptAt": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    }
  }
}
