{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wulfquest.invalid/schema/sprite.schema.json",
  "title": "*.sprite.json — AGENTS.md §10.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "size", "origin", "legend", "frames"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "size": {
      "type": "object", "additionalProperties": false, "required": ["w", "h"],
      "properties": {
        "w": { "type": "integer", "minimum": 1, "maximum": 256 },
        "h": { "type": "integer", "minimum": 1, "maximum": 192 }
      }
    },
    "origin": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "type": "integer" }, "y": { "type": "integer" } }
    },
    "legend": {
      "type": "object", "minProperties": 1,
      "propertyNames": { "minLength": 1, "maxLength": 1 },
      "additionalProperties": { "type": "integer", "minimum": -1, "maximum": 15 }
    },
    "frames": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "rows"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "rows": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "anchors": {
            "description": "Named points in sprite pixels, e.g. the hand the blade is drawn from; mirrored frames flip x",
            "type": "object",
            "propertyNames": { "pattern": "^[a-z][a-zA-Z]*$" },
            "additionalProperties": {
              "type": "object", "additionalProperties": false, "required": ["x", "y"],
              "properties": { "x": { "type": "integer" }, "y": { "type": "integer" } }
            }
          }
        }
      }
    },
    "mirror": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["from", "flipX"],
        "properties": { "from": { "type": "string" }, "flipX": { "type": "boolean" } }
      }
    }
  }
}
