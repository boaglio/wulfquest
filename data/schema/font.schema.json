{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wulfquest.invalid/schema/font.schema.json",
  "title": "font.json — AGENTS.md §10.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sets"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "sets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "size", "advance", "lineHeight", "legend", "glyphs", "fallback"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "size": {
            "type": "object",
            "additionalProperties": false,
            "required": ["w", "h"],
            "properties": {
              "w": { "type": "integer", "minimum": 1, "maximum": 32 },
              "h": { "type": "integer", "minimum": 1, "maximum": 32 }
            }
          },
          "advance": { "type": "integer", "minimum": 1 },
          "lineHeight": { "type": "integer", "minimum": 1 },
          "legend": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "integer", "minimum": -1, "maximum": 15 }
          },
          "glyphs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          },
          "fallback": { "type": "string", "minLength": 1, "maxLength": 1 }
        }
      }
    }
  }
}
