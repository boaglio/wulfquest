{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wulfquest.invalid/schema/treasures.schema.json",
  "title": "world/treasures.json — AGENTS.md §16.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fidelity", "source", "fillPercent", "fillPercentFidelity", "score", "pickupBox",
               "sprite", "fromScreen", "kinds", "slotsByRoomType"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "fidelity": { "enum": ["canon", "recon", "new"] },
    "source": { "type": "string", "minLength": 1 },
    "fillPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
    "fillPercentFidelity": { "enum": ["canon", "recon", "new"] },
    "score": { "type": "integer", "minimum": 0 },
    "pickupBox": { "$ref": "#/$defs/box" },
    "sprite": { "type": "string", "minLength": 1 },
    "fromScreen": {
      "type": "object", "additionalProperties": false, "required": ["dx", "dy"],
      "properties": { "dx": { "type": "integer" }, "dy": { "type": "integer" } }
    },
    "kinds": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["frame", "ink", "effect"],
        "properties": {
          "frame": { "type": "string", "minLength": 1 },
          "ink": { "type": "string", "minLength": 1 },
          "effect": { "enum": ["score", "extraLife"] }
        }
      }
    },
    "slotsByRoomType": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "array", "maxItems": 4,
        "items": {
          "type": "object", "additionalProperties": false, "required": ["x", "y"],
          "properties": { "x": { "type": "integer", "minimum": 0, "maximum": 255 },
                          "y": { "type": "integer", "minimum": 0, "maximum": 191 } }
        }
      }
    }
  },
  "$defs": {
    "box": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "w", "h"],
      "properties": { "x": { "type": "integer" }, "y": { "type": "integer" },
                      "w": { "type": "integer", "minimum": 1 }, "h": { "type": "integer", "minimum": 1 } }
    }
  }
}
