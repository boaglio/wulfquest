{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wulfquest.invalid/schema/sfx.schema.json",
  "title": "sfx.json — AGENTS.md §18.2 (procedural 1-bit beeper)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sampleRateHz", "channels", "bufferFrames", "cadence", "sfx"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "sampleRateHz": { "type": "integer", "minimum": 8000, "maximum": 96000 },
    "channels": { "type": "integer", "minimum": 1, "maximum": 4 },
    "bufferFrames": { "type": "integer", "minimum": 64, "maximum": 16384 },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["footstepEveryTicks"],
      "properties": { "footstepEveryTicks": { "type": "integer", "minimum": 1, "maximum": 100 } }
    },
    "sfx": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "loop", "steps"],
        "properties": {
          "priority": { "type": "integer", "minimum": 0, "maximum": 9 },
          "loop": { "type": "boolean" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["shape", "hz", "ms", "volPerMille", "slideToHz", "vibratoHz", "vibratoDepthPerMille"],
              "properties": {
                "shape": { "enum": ["square", "noise"] },
                "hz": { "type": "integer", "minimum": 20, "maximum": 20000 },
                "ms": { "type": "integer", "minimum": 1, "maximum": 5000 },
                "volPerMille": { "type": "integer", "minimum": 0, "maximum": 1000 },
                "slideToHz": { "type": "integer", "minimum": 0, "maximum": 20000 },
                "vibratoHz": { "type": "integer", "minimum": 0, "maximum": 50 },
                "vibratoDepthPerMille": { "type": "integer", "minimum": 0, "maximum": 1000 }
              }
            }
          }
        }
      }
    }
  }
}
