<?xml version="1.0" encoding="UTF-8"?>
<!--
  Windows, Linux and the plain jar: the window, the keyboard, gamepads, Java
  Sound and Boot, around the game in core. tools/package.sh turns its jar into
  the downloads.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>wulf</groupId>
    <artifactId>wulfquest-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>wulfquest-desktop</artifactId>
  <name>Wulf Quest for the desktop</name>

  <dependencies>
    <dependency>
      <groupId>wulf</groupId>
      <artifactId>wulfquest-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.badlogicgames.jamepad</groupId>
      <artifactId>jamepad</artifactId>
    </dependency>
  </dependencies>

  <build>
    <!-- The jar keeps the name it always had: wulfquest-VERSION.jar. -->
    <finalName>wulfquest-${project.version}</finalName>

    <resources>
      <!-- §19.3: the gamepad's own mappings file, which SDL reads at start. -->
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The GPL travels with every copy of the game (README: Licence). -->
      <resource>
        <directory>${project.basedir}/..</directory>
        <includes><include>LICENSE</include></includes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${mainClass}</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!--
        AGENTS.md §24 M8/M9: one double-clickable jar. Shade folds core, the
        dependencies and the content database into the artifact itself, so the
        game runs from wherever it is dropped with no classpath and no data/
        directory beside it (JsonDb falls back to the classpath, §20.1).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <!-- Other people's signatures do not survive being repacked. -->
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
                <!-- §19.3: Jamepad's 32-bit natives; no Java 21 runtime we ship or name runs there. -->
                <filter>
                  <artifact>com.badlogicgames.jamepad:jamepad</artifact>
                  <excludes>
                    <exclude>jamepad.dll</exclude>
                    <exclude>libjamepad.so</exclude>
                    <exclude>libjamepadarm.so</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${mainClass}</mainClass>
                  <manifestEntries>
                    <!-- §19.3: Jamepad loads its natives; Java 24 and later warn unless the jar says so. -->
                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>${exec.mainClass}</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
