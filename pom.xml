<?xml version="1.0" encoding="UTF-8"?>
<!--
  Wulf Quest — the parent build. See DEVELOPER.md for the modules and the
  command list; do not invoke javac directly.

  core     the game: simulation, world, data, menus, the framebuffer. No AWT,
           Swing or sound (CorePurityTest), so every platform can share it.
  desktop  Windows, Linux and the jar: the window, keys, gamepads, sound, Boot.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>wulf</groupId>
  <artifactId>wulfquest-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Wulf Quest</name>
  <description>A clean-room homage to the 1984 flip-screen jungle maze. All art, audio and code original.</description>

  <licenses>
    <license>
      <name>GPL-3.0-or-later</name>
      <url>https://www.gnu.org/licenses/gpl-3.0.html</url>
    </license>
  </licenses>

  <modules>
    <module>core</module>
    <module>desktop</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <!-- AGENTS.md §3: pinned, and all present in the local repository cache. -->
    <!-- Jackson 3 (tools.jackson); json-schema-validator 3.x is built on it,
         so both halves of the data layer share one JsonNode type. -->
    <jackson.version>3.1.7</jackson.version>
    <jsonschema.version>3.0.1</jsonschema.version>
    <junit.version>5.12.2</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <!-- §19.3: gamepads, through SDL2's game controller API; the natives ride in its jar. -->
    <jamepad.version>2.30.0.0</jamepad.version>

    <!--
      Which JUnit tags to leave out. Empty by default: AGENTS.md §22 says verify runs
      everything. The profiles below narrow it, and because the plugin reads this property
      rather than a literal, they actually take effect.
    -->
    <excludedGroups></excludedGroups>

    <!-- §22.5: -Dgolden.update=true rewrites the golden frames instead of checking them. -->
    <golden.update>false</golden.update>

    <!-- The game's entry point, in desktop. -Dexec.mainClass=wulf.tools.X runs a tool
         instead; exec:java runs in desktop only (it is skipped here and in core). -->
    <mainClass>wulf.Boot</mainClass>
    <exec.mainClass>${mainClass}</exec.mainClass>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>wulf</groupId>
        <artifactId>wulfquest-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${jsonschema.version}</version>
      </dependency>
      <dependency>
        <groupId>com.badlogicgames.jamepad</groupId>
        <artifactId>jamepad</artifactId>
        <version>${jamepad.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-nop</artifactId>
        <version>2.0.17</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Every module is tested the same way. -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
          <configuration>
            <compilerArgs>
              <arg>-Xlint:all</arg>
              <arg>-Werror</arg>
            </compilerArgs>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.6</version>
          <configuration>
            <!-- Tests read data/ and replays/ where they are: at the top of the repository. -->
            <workingDirectory>${project.basedir}/..</workingDirectory>
            <excludedGroups>${excludedGroups}</excludedGroups>
            <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
            <systemPropertyVariables>
              <!-- §22.5: the golden frames are rewritten only when you ask for it. -->
              <golden.update>${golden.update}</golden.update>
            </systemPropertyVariables>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>

        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.6.4</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- AGENTS.md §2.4: the no-binaries gate blocks the build. Once, over the whole repository. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <inherited>false</inherited>
        <!-- exec:java runs the game in desktop only; here there is nothing to run. -->
        <configuration>
          <skip>true</skip>
        </configuration>
        <executions>
          <execution>
            <id>check-no-binaries</id>
            <phase>verify</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>false</skip>
              <executable>${project.basedir}/tools/check-no-binaries.sh</executable>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- CI and display-less machines: skip anything that needs a window (§24 M9). -->
    <profile>
      <id>headless</id>
      <properties>
        <excludedGroups>gui</excludedGroups>
      </properties>
    </profile>

    <!-- Day to day, when the long replays are not what you are changing. -->
    <profile>
      <id>fast</id>
      <properties>
        <excludedGroups>slow</excludedGroups>
      </properties>
    </profile>
  </profiles>
</project>
