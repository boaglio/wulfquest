# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven build output
target/

# Local safety copies, never committed (AGENTS.md §24 M0)
attic/

# AGENTS.md §21.1 — the player DB lives in the OS user data dir, never here
save/

# Python bytecode from tools/art (dev-time only). The no-binaries gate (§2.4)
# rightly fails on these; never commit them, never allowlist them.
__pycache__/
*.pyc

# Empty placeholders the Claude Code sandbox mounts into the working tree:
# shell and git dotfiles, editor and agent config. Nothing here is project
# content. If a real .claude/ or editor config is ever wanted in the repo,
# un-ignore that one path.
.bash_profile
.bashrc
.profile
.zprofile
.zshrc
.gitconfig
.gitmodules
.ripgreprc
.mcp.json
.claude/
.idea
.vscode
